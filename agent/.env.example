# ============================================================
#  SafeNet Kids — Child Agent Environment Variables
#  You do NOT need to edit this file manually.
#  start_child_agent.bat creates .env automatically.
# ============================================================

# Gemini API key for AI content analysis (Vision)
GEMINI_API_KEY=your_gemini_api_key_here

# URL of the SafeNet backend server
SAFENET_API=https://safenetkidsproject-production.up.railway.app

# (Optional) Pre-set the link code to skip the prompt
# LINK_CODE=ABCD1234
